DATABASE_URL="file:./dev.db"

# Public site URL — used for canonicals, sitemap.xml, robots.txt and llms.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin dashboard credentials (/admin)
ADMIN_USERNAME="you@example.com"
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Primary destination site for the cross-domain backlink engine
NEXT_PUBLIC_MAIN_SITE_URL="https://beyondthetrek.com"
NEXT_PUBLIC_MAIN_SITE_NAME="Beyond The Trek"
