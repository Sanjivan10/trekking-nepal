# PostgreSQL connection (Neon). Pooled URL for the app, direct URL for schema changes.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Public site URL — canonicals, sitemap.xml, robots.txt, llms.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin dashboard credentials (/admin)
ADMIN_USERNAME="you@example.com"
ADMIN_PASSWORD="change-me"

# Signs the admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Cross-domain backlink engine target
NEXT_PUBLIC_MAIN_SITE_URL="https://beyondthetrek.com"
NEXT_PUBLIC_MAIN_SITE_NAME="Beyond The Trek"
